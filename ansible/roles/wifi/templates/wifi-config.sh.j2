#!/bin/sh
# Rendered by the wifi role ({{ template_path | default('roles/wifi') }}) — do not edit on the router.
# Band-aware: discovers whichever radios this board actually has (the BE14000
# NIC exposes 2g/5g/6g; an Orbi has 2g + two 5g; a board without the module
# simply has none) and creates each SSID only on its allowed bands. Safe to
# re-run: the role owns /etc/config/wireless outright and rebuilds every
# wifi-iface section. Channel widths + the fixed-channel plan come from the
# board's group_vars/board_<board>.yml.
set -e

# Fixed-channel plan (`wifi_channel_plan`, band → list of channels): radios
# of a band take the listed channels in uci order; a band without a plan, or
# more radios than channels, falls back to 'auto'. Needed where one board has
# two radios on the same band (Orbi: IPQ4019 + QCA9984, both 5 GHz) so they
# don't both auto-pick the same channel. Sets CH; must NOT run in a subshell
# (the per-band counters n_<band> live in this shell).
{% set bh = (wifi_backhaul | default('none')) in ['gate', 'node'] %}
{% if bh %}
{% if not (wifi_backhaul_key | default('')) %}
echo "wifi-config: wifi_backhaul={{ wifi_backhaul }} but wifi_backhaul_key is empty — add it to kleinbem-secrets/openwrt/shared.yaml" >&2
exit 1
{% endif %}
# Wireless backhaul ({{ wifi_backhaul }}): one radio is reserved for an
# encrypted 802.11s mesh point (board: {{ wifi_backhaul_band }} radio {{ wifi_backhaul_radio_path | default('') or '#' ~ wifi_backhaul_radio_index }},
# channel {{ wifi_backhaul_channel }}) and carries NO client SSIDs. Its netdev name is pinned
# ({{ wifi_backhaul_ifname }}) so roles/network can list it as a tagged trunk
# port of br-lan — every VLAN rides the mesh. The `backhaul` interface it
# attaches to is created by roles/network (br-lan, proto none).
BACKHAUL_RADIO=""
{% endif %}
pick_channel() {
  CH=auto
  case "$1" in
{% for band, chans in (wifi_channel_plan | default({})).items() %}
    {{ band }})
      eval "i=\${n_{{ band }}:-0}"
      set -- {{ chans | join(' ') }}
      if [ "$i" -lt $# ]; then shift "$i"; CH=$1; fi
      eval "n_{{ band }}=$((i + 1))"
      ;;
{% endfor %}
  esac
}

# Generate wifi-device sections for any radios not yet in /etc/config/wireless
# (first boot after flash). No-op when they already exist.
wifi config >/dev/null 2>&1 || true

# Wipe all existing wifi-iface sections — the SSID layout below is the single
# source of truth; anything else (firmware defaults, manual LuCI edits) goes.
while uci -q delete wireless.@wifi-iface[0]; do :; done

RADIOS=$(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')
if [ -z "$RADIOS" ]; then
  echo "wifi-config: no radios found — board without Wi-Fi NIC, nothing to do."
  exit 0
fi

for radio in $RADIOS; do
  band=$(uci -q get "wireless.$radio.band")
  uci set "wireless.$radio.country"='{{ wifi_country }}'
  uci set "wireless.$radio.disabled"='0'
{% if bh %}
  if [ "$band" = "{{ wifi_backhaul_band }}" ]; then
{% if wifi_backhaul_radio_path | default('') %}
    # Picked by uci path: enumeration order of on-SoC vs PCIe radios isn't fixed.
    case "$(uci -q get "wireless.$radio.path")" in
      {{ wifi_backhaul_radio_path }}) BACKHAUL_RADIO=$radio ;;
    esac
{% else %}
    k=${seen_backhaul_band:-0}
    [ "$k" -eq {{ wifi_backhaul_radio_index }} ] && BACKHAUL_RADIO=$radio
    seen_backhaul_band=$((k + 1))
{% endif %}
  fi
  if [ "$radio" = "$BACKHAUL_RADIO" ]; then
    uci set "wireless.$radio.channel"='{{ wifi_backhaul_channel }}'
    uci set "wireless.$radio.htmode"='{{ wifi_backhaul_htmode }}'
    uci set wireless.backhaul=wifi-iface
    uci set wireless.backhaul.device="$radio"
    uci set wireless.backhaul.mode='mesh'
    uci set wireless.backhaul.ifname='{{ wifi_backhaul_ifname }}'
    uci set wireless.backhaul.mesh_id={{ wifi_backhaul_mesh_id | quote }}
    uci set wireless.backhaul.encryption='sae'
    uci set wireless.backhaul.key={{ wifi_backhaul_key | quote }}
    uci set wireless.backhaul.mesh_fwding='1'
    uci set wireless.backhaul.network='backhaul'
    continue
  fi
{% endif %}
  pick_channel "$band"
  uci set "wireless.$radio.channel"="$CH"
  case "$band" in
{% for band, htmode in wifi_htmodes.items() %}
    {{ band }}) uci set "wireless.$radio.htmode"='{{ htmode }}' ;;
{% endfor %}
  esac

{% for net in wifi_networks %}
{% if net.mpsk | default(false) %}
  # SSID: {{ net.name }} (MPSK) — the PASSWORD selects the VLAN. hostapd reads
  # /etc/hostapd/{{ net.name }}.wpa_psk (vlanid= per line) and dynamic_vlan
  # tags each station into br-lan.<vlanid>. Base bind: '{{ net.default_network }}'.
  case "$band" in {{ net.bands | join('|') }})
    iface='{{ net.name }}_'"$radio"
    uci set "wireless.$iface"=wifi-iface
    uci set "wireless.$iface.device"="$radio"
    uci set "wireless.$iface.mode"='ap'
    # 802.11k (neighbor reports) + 802.11v (BSS transition) — give clients the
    # info to roam smartly between the two APs; complements 802.11r + DAWN.
    uci set "wireless.$iface.ieee80211k"='1'
    uci set "wireless.$iface.bss_transition"='1'
    uci set "wireless.$iface.ssid"={{ net.ssid | quote }}
    uci set "wireless.$iface.network"='{{ net.default_network }}'
    uci set "wireless.$iface.wpa_psk_file"='/etc/hostapd/{{ net.name }}.wpa_psk'
    uci set "wireless.$iface.dynamic_vlan"='2'
    uci set "wireless.$iface.vlan_naming"='1'
    uci set "wireless.$iface.vlan_bridge"='br-lan'
    if [ "$band" = "6g" ]; then
      uci set "wireless.$iface.encryption"='sae'
      uci set "wireless.$iface.ieee80211w"='2'
    else
      uci set "wireless.$iface.encryption"='{{ net.encryption }}'
    fi
{% if net.ft | default(false) %}
    uci set "wireless.$iface.ieee80211r"='1'
    uci set "wireless.$iface.mobility_domain"='{{ net.mobility_domain }}'
    uci set "wireless.$iface.ft_over_ds"='0'
    uci set "wireless.$iface.ft_psk_generate_local"='1'
{% endif %}
  ;; esac
{% else %}
  # SSID: {{ net.name }} → network '{{ net.network }}'
  case "$band" in {{ net.bands | join('|') }})
    iface='{{ net.name }}_'"$radio"
    uci set "wireless.$iface"=wifi-iface
    uci set "wireless.$iface.device"="$radio"
    uci set "wireless.$iface.mode"='ap'
    # 802.11k (neighbor reports) + 802.11v (BSS transition) — give clients the
    # info to roam smartly between the two APs; complements 802.11r + DAWN.
    uci set "wireless.$iface.ieee80211k"='1'
    uci set "wireless.$iface.bss_transition"='1'
    uci set "wireless.$iface.ssid"={{ net.ssid | quote }}
    uci set "wireless.$iface.key"={{ net.key | quote }}
    uci set "wireless.$iface.network"='{{ net.network }}'
    if [ "$band" = "6g" ]; then
      # 6 GHz mandates pure WPA3-SAE + management frame protection.
      uci set "wireless.$iface.encryption"='sae'
      uci set "wireless.$iface.ieee80211w"='2'
    else
      uci set "wireless.$iface.encryption"='{{ net.encryption }}'
    fi
{% if net.ft | default(false) %}
    # 802.11r fast transition between the two BPI-R4s (same mobility domain).
    uci set "wireless.$iface.ieee80211r"='1'
    uci set "wireless.$iface.mobility_domain"='{{ net.mobility_domain }}'
    uci set "wireless.$iface.ft_over_ds"='0'
    uci set "wireless.$iface.ft_psk_generate_local"='1'
{% endif %}
{% if net.isolate | default(false) %}
    uci set "wireless.$iface.isolate"='1'
{% endif %}
  ;; esac
{% endif %}
{% endfor %}
done

{% if bh %}
if [ -z "$BACKHAUL_RADIO" ]; then
{% if wifi_backhaul_radio_path | default('') %}
  echo "wifi-config: no {{ wifi_backhaul_band }} radio with path {{ wifi_backhaul_radio_path }} for the backhaul — check wifi_backhaul_radio_path (uci show wireless | grep path)" >&2
{% else %}
  echo "wifi-config: no {{ wifi_backhaul_band }} radio #{{ wifi_backhaul_radio_index }} for the backhaul on this board — check wifi_backhaul_radio_index" >&2
{% endif %}
  exit 1
fi
{% endif %}
uci commit wireless
wifi reload
